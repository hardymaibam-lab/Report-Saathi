# Gemini API key (Leave empty or 'mock' to use simulated analysis mode)
GEMINI_API_KEY=

# Tesseract executable (available in PATH on Windows as tesseract)
TESSERACT_CMD=tesseract

# Supabase (Optional - leave empty for guest local session storage)
SUPABASE_URL=
SUPABASE_KEY=

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
